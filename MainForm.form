{
  "format": "bintana-form/1",
  "class": "MainForm",
  "properties": {
    "Text": "Bintana Draw",
    "Icon": "io.github.getbintana.Draw",
    "Width": 1220,
    "Height": 780,
    "Arrangement": "Vertical",
    "Spacing": 0,
    "Padding": "0",
    "Remember": true,
    "AcceptFiles": true
  },
  "actions": [
    { "name": "ActNew", "text": "New", "shortcut": "<Control>n" },
    { "name": "ActOpen", "text": "Open…", "shortcut": "<Control>o" },
    { "name": "ActSave", "text": "Save", "shortcut": "<Control>s" },
    { "name": "ActSaveAs", "text": "Save As…", "shortcut": "<Control><Shift>s" },
    { "name": "ActExportPng", "text": "Export PNG…" },
    { "name": "ActExportPdf", "text": "Export PDF…" },
    { "name": "ActQuit", "text": "Quit", "shortcut": "<Control>q" },
    { "name": "ActUndo", "text": "Undo", "shortcut": "<Control>z", "enabled": false },
    { "name": "ActRedo", "text": "Redo", "shortcut": "<Control><Shift>z", "enabled": false },
    { "name": "ActCut", "text": "Cut", "shortcut": "<Control>x", "enabled": false },
    { "name": "ActCopy", "text": "Copy", "shortcut": "<Control>c", "enabled": false },
    { "name": "ActPaste", "text": "Paste", "shortcut": "<Control>v", "enabled": false },
    { "name": "ActDuplicate", "text": "Duplicate", "shortcut": "<Control>d", "enabled": false },
    { "name": "ActDelete", "text": "Delete", "shortcut": "Delete", "enabled": false },
    { "name": "ActSelectAll", "text": "Select All", "shortcut": "<Control>a" },
    { "name": "ActBringFront", "text": "Bring to Front", "enabled": false },
    { "name": "ActSendBack", "text": "Send to Back", "enabled": false },
    { "name": "ActBringForward", "text": "Bring Forward", "enabled": false },
    { "name": "ActSendBackward", "text": "Send Backward", "enabled": false },
    { "name": "ActAlignLeft", "text": "Align Left", "enabled": false },
    { "name": "ActAlignCenter", "text": "Align Center", "enabled": false },
    { "name": "ActAlignRight", "text": "Align Right", "enabled": false },
    { "name": "ActAlignTop", "text": "Align Top", "enabled": false },
    { "name": "ActAlignMiddle", "text": "Align Middle", "enabled": false },
    { "name": "ActAlignBottom", "text": "Align Bottom", "enabled": false },
    { "name": "ActDistributeHorizontal", "text": "Distribute Horizontally", "enabled": false },
    { "name": "ActDistributeVertical", "text": "Distribute Vertically", "enabled": false },
    { "name": "ActZoomIn", "text": "Zoom In" },
    { "name": "ActZoomOut", "text": "Zoom Out" },
    { "name": "ActZoomReset", "text": "Actual Size" },
    { "name": "ActZoomFit", "text": "Fit to Window" }
  ],
  "menus": [
    {
      "name": "MnuFile",
      "text": "_File",
      "children": [
        { "action": "ActNew" },
        { "action": "ActOpen" },
        { "separator": true },
        { "action": "ActSave" },
        { "action": "ActSaveAs" },
        { "separator": true },
        { "action": "ActExportPng" },
        { "action": "ActExportPdf" },
        { "separator": true },
        { "action": "ActQuit" }
      ]
    },
    {
      "name": "MnuEdit",
      "text": "_Edit",
      "children": [
        { "action": "ActUndo" },
        { "action": "ActRedo" },
        { "separator": true },
        { "action": "ActCut" },
        { "action": "ActCopy" },
        { "action": "ActPaste" },
        { "action": "ActDuplicate" },
        { "action": "ActDelete" },
        { "separator": true },
        { "action": "ActSelectAll" },
        { "separator": true },
        {
          "name": "MnuAlign",
          "text": "Align",
          "children": [
            { "action": "ActAlignLeft" },
            { "action": "ActAlignCenter" },
            { "action": "ActAlignRight" },
            { "separator": true },
            { "action": "ActAlignTop" },
            { "action": "ActAlignMiddle" },
            { "action": "ActAlignBottom" }
          ]
        },
        {
          "name": "MnuDistribute",
          "text": "Distribute",
          "children": [
            { "action": "ActDistributeHorizontal" },
            { "action": "ActDistributeVertical" }
          ]
        },
        { "separator": true },
        {
          "name": "MnuOrder",
          "text": "Order",
          "children": [
            { "action": "ActBringFront" },
            { "action": "ActSendBack" },
            { "action": "ActBringForward" },
            { "action": "ActSendBackward" }
          ]
        }
      ]
    },
    {
      "name": "MnuView",
      "text": "_View",
      "children": [
        { "action": "ActZoomIn" },
        { "action": "ActZoomOut" },
        { "action": "ActZoomReset" },
        { "action": "ActZoomFit" },
        { "separator": true },
        { "name": "MnuGrid", "text": "Show Grid", "check": true }
      ]
    },
    {
      "name": "MnuHelp",
      "text": "_Help",
      "children": [
        { "name": "MnuShortcuts", "text": "Keyboard Shortcuts" },
        { "name": "MnuAbout", "text": "About Bintana Draw" }
      ]
    }
  ],
  "children": [
    {
      "type": "Panel",
      "name": "Toolbar",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 4,
        "Padding": "6 8",
        "Height": 46,
        "Style": "draw-toolbar"
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnNew",
          "properties": {
            "Action": "ActNew",
            "Style": "flat",
            "Height": 34
          }
        },
        {
          "type": "Button",
          "name": "BtnOpen",
          "properties": {
            "Action": "ActOpen",
            "Style": "flat",
            "Height": 34
          }
        },
        {
          "type": "Button",
          "name": "BtnSave",
          "properties": {
            "Action": "ActSave",
            "Style": "flat",
            "Height": 34
          }
        },
        {
          "type": "Separator",
          "name": "Sep1",
          "properties": { "Orientation": "Vertical", "Width": 14, "Height": 26 }
        },
        {
          "type": "Button",
          "name": "BtnUndo",
          "properties": {
            "Action": "ActUndo",
            "Style": "flat",
            "Height": 34
          }
        },
        {
          "type": "Button",
          "name": "BtnRedo",
          "properties": {
            "Action": "ActRedo",
            "Style": "flat",
            "Height": 34
          }
        },
        {
          "type": "Separator",
          "name": "Sep2",
          "properties": { "Orientation": "Vertical", "Width": 14, "Height": 26 }
        },
        {
          "type": "Button",
          "name": "BtnZoomOut",
          "properties": {
            "Action": "ActZoomOut",
            "Style": "flat",
            "Height": 34
          }
        },
        {
          "type": "Button",
          "name": "BtnZoomIn",
          "properties": {
            "Action": "ActZoomIn",
            "Style": "flat",
            "Height": 34
          }
        },
        {
          "type": "Button",
          "name": "BtnZoomFit",
          "properties": {
            "Action": "ActZoomFit",
            "Style": "flat",
            "Height": 34
          }
        },
        {
          "type": "Separator",
          "name": "Sep3",
          "properties": { "Orientation": "Vertical", "Width": 14, "Height": 26 }
        },
        {
          "type": "Button",
          "name": "BtnDelete",
          "properties": {
            "Action": "ActDelete",
            "Style": "flat",
            "Height": 34
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "FormatBar",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 6,
        "Padding": "4 10",
        "Height": 40,
        "Style": "draw-formatbar"
      },
      "children": [
        {
          "type": "Label",
          "name": "LblStroke",
          "properties": { "Text": "Line", "For": "SpnStrokeWidth" }
        },
        {
          "type": "SpinBox",
          "name": "SpnStrokeWidth",
          "properties": {
            "Min": 1, "Max": 8, "Step": 1, "Decimals": 0,
            "Value": 2, "Numeric": true, "Width": 64, "Height": 30,
            "AccessibleName": "Line width"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbDash",
          "properties": {
            "Width": 110, "Height": 30, "AccessibleName": "Line style"
          }
        },
        {
          "type": "Separator",
          "name": "FmtSep1",
          "properties": { "Orientation": "Vertical", "Width": 14, "Height": 24 }
        },
        {
          "type": "Label",
          "name": "LblFont",
          "properties": { "Text": "Text", "For": "SpnFont" }
        },
        {
          "type": "SpinBox",
          "name": "SpnFont",
          "properties": {
            "Min": 6, "Max": 72, "Step": 1, "Decimals": 0,
            "Value": 12, "Numeric": true, "Width": 64, "Height": 30,
            "AccessibleName": "Font size"
          }
        },
        {
          "type": "ToggleButton",
          "name": "BtnBold",
          "properties": {
            "Text": "B", "Tooltip": "Bold", "AccessibleName": "Bold",
            "Font": "Sans Bold 12", "Width": 34, "Height": 30
          }
        },
        {
          "type": "ToggleButton",
          "name": "BtnItalic",
          "properties": {
            "Text": "I", "Tooltip": "Italic", "AccessibleName": "Italic",
            "Font": "Sans Italic 12", "Width": 34, "Height": 30
          }
        },
        {
          "type": "Separator",
          "name": "FmtSep2",
          "properties": { "Orientation": "Vertical", "Width": 14, "Height": 24 }
        },
        {
          "type": "Label",
          "name": "LblAlign",
          "properties": { "Text": "Align" }
        },
        {
          "type": "ToggleButton",
          "name": "BtnAlignLeft",
          "properties": {
            "Text": "L", "Tooltip": "Align left", "AccessibleName": "Align left",
            "Width": 30, "Height": 30
          }
        },
        {
          "type": "ToggleButton",
          "name": "BtnAlignCenter",
          "properties": {
            "Text": "C", "Tooltip": "Align center",
            "AccessibleName": "Align center", "Active": true,
            "Width": 30, "Height": 30
          }
        },
        {
          "type": "ToggleButton",
          "name": "BtnAlignRight",
          "properties": {
            "Text": "R", "Tooltip": "Align right",
            "AccessibleName": "Align right", "Width": 30, "Height": 30
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbVAlign",
          "properties": {
            "Width": 110, "Height": 30, "AccessibleName": "Vertical alignment"
          }
        },
        {
          "type": "Separator",
          "name": "FmtSep3",
          "properties": { "Orientation": "Vertical", "Width": 14, "Height": 24 }
        },
        {
          "type": "ColorButton",
          "name": "BtnTextColor",
          "properties": {
            "AccessibleName": "Text color", "Tooltip": "Text color",
            "HAlign": "Start", "Width": 64, "Height": 28,
            "Value": "rgb(31,41,55)"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Body",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 0,
        "Expand": true
      },
      "children": [
        {
          "type": "Panel",
          "name": "Palette",
          "properties": {
            "Arrangement": "Vertical",
            "Spacing": 5,
            "Padding": "10",
            "Width": 184,
            "Style": "draw-sidebar"
          },
          "children": [
            {
              "type": "Label",
              "name": "LblShapes",
              "properties": {
                "Text": "Shapes",
                "Style": "section-title",
                "Height": 24
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolSelect",
              "properties": {
                "Text": "Select",
                "Active": true,
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolRect",
              "properties": {
                "Text": "Rectangle",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolRound",
              "properties": {
                "Text": "Rounded rectangle",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolEllipse",
              "properties": {
                "Text": "Ellipse",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolDiamond",
              "properties": {
                "Text": "Decision",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolTerminator",
              "properties": {
                "Text": "Terminator",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolData",
              "properties": {
                "Text": "Data",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolCylinder",
              "properties": {
                "Text": "Database",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolNote",
              "properties": {
                "Text": "Note",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolText",
              "properties": {
                "Text": "Text",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnToolConnect",
              "properties": {
                "Text": "Connector",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "Label",
              "name": "LblStyle",
              "properties": {
                "Text": "Style",
                "Style": "section-title",
                "Height": 24
              }
            },
            {
              "type": "Label",
              "name": "LblFill",
              "properties": {
                "Text": "Fill",
                "For": "BtnFill",
                "Height": 22
              }
            },
            {
              "type": "ColorButton",
              "name": "BtnFill",
              "properties": {
                "Value": "rgb(218,232,252)",
                "AccessibleName": "Fill color",
                "HAlign": "Start",
                "Width": 70,
                "Height": 28
              }
            },
            {
              "type": "Label",
              "name": "LblLine",
              "properties": {
                "Text": "Line",
                "For": "BtnLine",
                "Height": 22
              }
            },
            {
              "type": "ColorButton",
              "name": "BtnLine",
              "properties": {
                "Value": "rgb(108,142,191)",
                "AccessibleName": "Line color",
                "HAlign": "Start",
                "Width": 70,
                "Height": 28
              }
            },
            {
              "type": "Label",
              "name": "LblTip",
              "properties": {
                "Text": "Pick a shape, then drag on the canvas.",
                "Style": "dim-label",
                "Wrap": true,
                "Expand": true,
                "VAlign": "End",
                "Height": 48
              }
            }
          ]
        },
        {
          "type": "Panel",
          "name": "Stage",
          "properties": {
            "Expand": true,
            "HAlign": "Fill",
            "VAlign": "Fill",
            "Style": "draw-stage"
          },
          "children": [
            {
              "type": "DrawingArea",
              "name": "Canvas",
              "properties": {
                "X": 0,
                "Y": 0,
                "Width": 100,
                "Height": 100,
                "HAlign": "Fill",
                "VAlign": "Fill",
                "Focusable": true,
                "AcceptFiles": true,
                "Cursor": "Arrow",
                "AccessibleName": "Diagram canvas",
                "Menu": [
                  { "action": "ActUndo" },
                  { "action": "ActRedo" },
                  { "separator": true },
                  { "action": "ActCut" },
                  { "action": "ActCopy" },
                  { "action": "ActPaste" },
                  { "action": "ActDuplicate" },
                  { "action": "ActDelete" },
                  { "separator": true },
                  { "action": "ActSelectAll" },
                  { "separator": true },
                  {
                    "text": "Order",
                    "children": [
                      { "action": "ActBringFront" },
                      { "action": "ActSendBack" },
                      { "action": "ActBringForward" },
                      { "action": "ActSendBackward" }
                    ]
                  }
                ]
              }
            },
            {
              "type": "TextBox",
              "name": "TxtEdit",
              "properties": {
                "X": 12,
                "Y": 12,
                "Width": 200,
                "Height": 32,
                "Visible": false,
                "Font": "Sans 12",
                "ActivatesDefault": false,
                "AccessibleName": "Label text",
                "Style": "inline-edit",
                "Padding": "2 6"
              }
            }
          ]
        },
        {
          "type": "Panel",
          "name": "LayersPanel",
          "properties": {
            "Arrangement": "Vertical",
            "Spacing": 6,
            "Padding": "10",
            "Width": 216,
            "Style": "draw-sidebar-right"
          },
          "children": [
            {
              "type": "Label",
              "name": "LblLayers",
              "properties": {
                "Text": "Layers",
                "Style": "section-title",
                "Height": 24
              }
            },
            {
              "type": "Scroller",
              "name": "LayerScroll",
              "properties": {
                "HAlign": "Fill",
                "VAlign": "Fill",
                "Expand": true,
                "Height": 160,
                "MinHeight": 120
              },
              "children": [
                {
                  "type": "ListBox",
                  "name": "LstLayers",
                  "properties": {
                    "HAlign": "Fill",
                    "VAlign": "Start",
                    "Width": 190,
                    "MinHeight": 40,
                    "AccessibleName": "Layers"
                  }
                }
              ]
            },
            {
              "type": "Panel",
              "name": "LayerAddRow",
              "properties": {
                "Arrangement": "Horizontal",
                "Spacing": 4,
                "Height": 32
              },
              "children": [
                {
                  "type": "Button",
                  "name": "BtnLayerAdd",
                  "properties": {
                    "Text": "Add",
                    "Height": 30,
                    "Expand": true
                  }
                },
                {
                  "type": "Button",
                  "name": "BtnLayerRemove",
                  "properties": {
                    "Text": "Remove",
                    "Height": 30,
                    "Expand": true
                  }
                }
              ]
            },
            {
              "type": "Panel",
              "name": "LayerMoveRow",
              "properties": {
                "Arrangement": "Horizontal",
                "Spacing": 4,
                "Height": 32
              },
              "children": [
                {
                  "type": "Button",
                  "name": "BtnLayerUp",
                  "properties": {
                    "Text": "Move up",
                    "Height": 30,
                    "Expand": true
                  }
                },
                {
                  "type": "Button",
                  "name": "BtnLayerDown",
                  "properties": {
                    "Text": "Move down",
                    "Height": 30,
                    "Expand": true
                  }
                }
              ]
            },
            {
              "type": "ToggleButton",
              "name": "BtnLayerVisible",
              "properties": {
                "Text": "Visible",
                "Active": true,
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "ToggleButton",
              "name": "BtnLayerLocked",
              "properties": {
                "Text": "Locked",
                "HAlign": "Fill",
                "Height": 30
              }
            },
            {
              "type": "Label",
              "name": "LblLayerName",
              "properties": {
                "Text": "Name",
                "For": "TxtLayerName",
                "Height": 22
              }
            },
            {
              "type": "TextBox",
              "name": "TxtLayerName",
              "properties": {
                "HAlign": "Fill",
                "Height": 32,
                "AccessibleName": "Layer name"
              }
            },
            {
              "type": "Button",
              "name": "BtnLayerAssign",
              "properties": {
                "Text": "Move selection here",
                "HAlign": "Fill",
                "Height": 34
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Panel",
      "name": "PageBar",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 6,
        "Padding": "5 10",
        "Height": 38,
        "Style": "draw-pagebar"
      },
      "children": [
        {
          "type": "Label",
          "name": "LblPage",
          "properties": {
            "Text": "Page",
            "For": "CmbPage"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbPage",
          "properties": {
            "Width": 220,
            "Height": 32,
            "Expand": true,
            "AccessibleName": "Pages"
          }
        },
        {
          "type": "Button",
          "name": "BtnPageAdd",
          "properties": {
            "Text": "Add page",
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "BtnPageRemove",
          "properties": {
            "Text": "Remove page",
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "BtnPageUp",
          "properties": {
            "Text": "Move page up",
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "BtnPageDown",
          "properties": {
            "Text": "Move page down",
            "Height": 30
          }
        },
        {
          "type": "Label",
          "name": "LblPageName",
          "properties": {
            "Text": "Name",
            "For": "TxtPageName"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtPageName",
          "properties": {
            "Width": 180,
            "Height": 30,
            "AccessibleName": "Page name"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Status",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 10,
        "Padding": "5 10",
        "Height": 30,
        "Style": "draw-status"
      },
      "children": [
        {
          "type": "Label",
          "name": "LblStatus",
          "properties": {
            "Text": "Ready",
            "Expand": true,
            "Alignment": "Left",
            "Ellipsize": true
          }
        },
        {
          "type": "Label",
          "name": "LblCount",
          "properties": {
            "Text": "",
            "Width": 130,
            "Alignment": "Right",
            "AccessibleName": "Diagram contents"
          }
        },
        {
          "type": "Label",
          "name": "LblZoom",
          "properties": {
            "Text": "100%",
            "Width": 60,
            "Alignment": "Right",
            "AccessibleName": "Zoom level"
          }
        }
      ]
    }
  ]
}
